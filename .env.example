# CoinClash environment variables.
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
# In CI these come from GitHub Actions secrets (see CLAUDE.md "Secrets").

# ---------- Shared ----------
# mock | regtest | mainnet. `mock` is for tests/CI/offline UI dev only, never for players.
NETWORK=regtest

# ---------- Server (apps/server) ----------
PORT=8787
# Public origin of the web app (CORS + invite links). Production: https://coinclash.vip
PUBLIC_WEB_ORIGIN=http://localhost:5173
# MongoDB Atlas SRV connection string: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=coinclash
# Secret used to sign short-lived session tokens (random 32+ bytes, hex)
SESSION_SECRET=
SESSION_TTL_SECONDS=3600

# Breez SDK API key for the SERVER house wallet (server-only; see docs/decisions/0005)
BREEZ_API_KEY=
# 12/24-word mnemonic of the server HOUSE wallet (regtest welcome bonus only; it never holds match
# funds, see docs/decisions/0002). SERVER-ONLY. Never in the browser, never in git.
HOUSE_MNEMONIC=
# How stakes are held: escrow (active, ADR 0013) or htlc (dormant, ADR 0002)
ESCROW_MODE=escrow
# 12/24-word mnemonic of the server ESCROW wallet (holds pots during matches). SERVER-ONLY.
ESCROW_MNEMONIC=
# Where the server's Breez SDK keeps its local state
BREEZ_STORAGE_DIR=./.data/breez-server

# Stake limits (sats)
STAKE_MIN_SATS=100
STAKE_MAX_SATS=100000

# Timers (seconds)
# Time for both players to lock their stake HTLCs
LOCK_TIMEOUT_SECONDS=180
# Time the winner has to claim after the result (part of the HTLC expiry)
CLAIM_WINDOW_SECONDS=900
DISCONNECT_GRACE_SECONDS=60

# Welcome bonus (regtest only): sent once per wallet identity
WELCOME_BONUS_SATS=10000
WELCOME_BONUS_ENABLED=true
# Max welcome bonuses per IP per hour (a venue shares one Wi-Fi IP, so keep this generous)
WELCOME_BONUS_RATE_LIMIT_PER_HOUR=60

# Trivia question source
OPENTDB_ENABLED=true

# ---------- Web (apps/web) — VITE_* values are PUBLIC: baked into the browser bundle ----------
VITE_SERVER_URL=http://localhost:8787
VITE_NETWORK=regtest
# Breez API key for the browser wallet. This is EXPOSED to every visitor (unavoidable for a
# client-side wallet). Use a key dedicated to the web app so it can be rotated independently.
VITE_BREEZ_API_KEY=
# WebAuthn relying party ID for passkeys = the domain (no scheme/port). Production: coinclash.vip
# Wallets are bound to this value: changing it later means users get different wallets.
VITE_PASSKEY_RP_ID=localhost
VITE_PASSKEY_RP_NAME=CoinClash
# Regtest faucet link shown in the Wallet screen
VITE_REGTEST_FAUCET_URL=https://app.lightspark.com/regtest-faucet
