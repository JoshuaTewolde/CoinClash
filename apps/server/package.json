    "@coinclash/game-rps": "workspace:*",
    "@coinclash/game-sdk": "workspace:*",
    "@coinclash/game-tictactoe": "workspace:*",
    "@coinclash/game-trivia": "workspace:*",
    "@coinclash/rail": "workspace:*",
    "@coinclash/shared": "workspace:*",
    "@scure/bip39": "1.5.0",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "socket.io": "^4.8.1",
    "web-push": "3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/web-push": "3.6.4",
    "fast-check": "^3.23.2",
